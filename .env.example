# Signal Board's core data (titles, ratings, genres) comes from a bundled
# snapshot of IMDb's public non-commercial datasets (lib/imdb-data.json) —
# no key needed for that part. To refresh it (IMDb updates its source files
# daily): npm run build:imdb

# Optional — one-sentence plot descriptions per title, via OMDb.
# Free key: https://www.omdbapi.com/apikey.aspx
# Without this, titles just show without a description.
OMDB_API_KEY=
